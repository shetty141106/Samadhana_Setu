# Deployed Spring Boot API
VITE_API_BASE_URL=https://samadhana-setu.onrender.com

# Enable real backend integration
VITE_ENABLE_LIVE_API=true

# Cloudinary unsigned upload configuration for citizen evidence images
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Leaflet + OpenStreetMap is the primary map stack; Google Maps key is not required.
VITE_GOOGLE_MAPS_API_KEY=

# Local Spring Boot API
VITE_API_BASE_URL=http://localhost:8080

# Set true only after the deployed backend URL and CORS are verified.
VITE_ENABLE_LIVE_API=false

# Optional client-side services. Never put private AI credentials in VITE variables.
VITE_GOOGLE_MAPS_API_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

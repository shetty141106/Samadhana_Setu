<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SamadhanSetu — Report. Resolve. Rebuild Jharkhand.</title>
<meta name="description" content="SamadhanSetu is Jharkhand's citizen-to-solution bridge — report civic and environmental issues, collaborate with universities on R&D, and fund high-impact CSR projects, all in one platform.">
<meta property="og:title" content="SamadhanSetu — Report. Resolve. Rebuild Jharkhand.">
<meta property="og:description" content="A citizen–university–industry collaboration for a greener, stronger and sustainable Jharkhand.">
<meta property="og:type" content="website">
<!--
  TAILWIND: this file expects Tailwind to be compiled from your own build
  (see tailwind.config.js). No CDN script, no inline config here — only
  utility classes plus the small custom CSS block below for the motifs,
  reveal-on-scroll animation and focus states that aren't part of the
  Tailwind config itself.
-->
<link rel="stylesheet" href="./dist/output.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
<style>
  html { scroll-behavior: smooth; }
  body { font-family: 'Plus Jakarta Sans', sans-serif; }
  .font-serif-display { font-family: 'Cormorant Garamond', serif; }

  .motif-row {
    background-image: radial-gradient(circle, currentColor 1.4px, transparent 1.6px);
    background-size: 16px 16px;
  }
  .diamond-bullet::before {
    content: "";
    display: inline-block;
    width: 7px; height: 7px;
    background: currentColor;
    transform: rotate(45deg);
    margin-right: 10px;
  }
  .flag-dot { width: 9px; height: 9px; border-radius: 2px; display: inline-block; }

  .persona-card { transition: transform .35s ease, box-shadow .35s ease; }
  .persona-card:hover { transform: translateY(-6px); }

  .reveal { opacity: 0; transform: translateY(18px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.in { opacity: 1; transform: translateY(0); }

  ::selection { background: #E07A3D; color: #F8F5EE; }
  :focus-visible { outline: 3px solid #D4AF37; outline-offset: 2px; }

  @media (prefers-reduced-motion: reduce) {
    .reveal, .persona-card { transition: none !important; }
  }

  .step-line { background: linear-gradient(180deg, #83CAA9 0%, #1B5E3B 100%); }
</style>
</head>
<body class="bg-jh-earth-50 text-jh-charcoal antialiased">

<!-- ============ GOVT UTILITY BAR ============ -->
<div class="bg-jh-green-950 text-jh-earth-100 text-xs">

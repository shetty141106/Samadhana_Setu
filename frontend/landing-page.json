      <span class="flag-dot bg-jh-terracotta-500"></span>
      <span class="flag-dot bg-white"></span>
      <span class="flag-dot bg-jh-green-500"></span>
      <span class="ml-1">झारखंड सरकार | Government of Jharkhand</span>
      <span class="hidden sm:inline-flex items-center bg-jh-green-900 border border-jh-green-700 rounded-full px-3 py-1 ml-3 text-jh-green-200">samadhansetu.jharkhand.gov.in</span>
    </div>
    <div class="hidden md:flex items-center gap-4 text-jh-earth-200">
      <span class="flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 4 6 4 9s-1.5 6.4-4 9c-2.5-2.6-4-6-4-9s1.5-6.4 4-9z"/></svg>

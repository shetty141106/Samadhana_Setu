# Required for live Gemini NLP + Gemini embeddings + FAISS semantic deduplication
GEMINI_API_KEY=your_google_ai_studio_key

# Current Gemini text model used by the prototype
GEMINI_MODEL=gemini-3.8-flash

# Current Gemini embedding model used before FAISS nearest-neighbor search
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# Cosine similarity threshold for a duplicate flag
AI_DUPLICATE_THRESHOLD=0.78
